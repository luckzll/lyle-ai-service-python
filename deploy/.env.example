OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL_PROVIDER=deepseek
CHAT_MODEL_NAME=deepseek-v4-flash
INTENT_MODEL_PROVIDER=deepseek
INTENT_MODEL_NAME=deepseek-v4-flash
MEMORY_EXTRACT_MODEL_PROVIDER=deepseek
MEMORY_EXTRACT_MODEL_NAME=deepseek-v4-flash
SUMMARY_MODEL_PROVIDER=deepseek
SUMMARY_MODEL_NAME=deepseek-v4-flash
JUDGE_MODEL_PROVIDER=deepseek
JUDGE_MODEL_NAME=deepseek-v4-flash
VISION_MODEL_PROVIDER=ark
VISION_MODEL_NAME=doubao-seed-2-0-pro-260215
IMAGE_MODEL_PROVIDER=ark
IMAGE_MODEL_NAME=doubao-seedream-4-5-251128
REVIEWER_ENABLED=false
REVIEWER_MAX_RETRY=1
EVALUATION_JUDGE_ENABLED=false
TOOL_AGENT_ENABLED=true
TOOL_ROUTER_LLM_ENABLED=true
TOOL_ROUTER_CONTEXT_MAX_CHARS=3000
TOOL_ALLOWED_NAMES=health_check,memory_snapshot,list_tools,memory_stats,work_summary,web_search,weather,file_parse,image_analyze,image_generate,image_edit,todo,calendar
TOOL_AUDIT_ENABLED=true
TOOL_DATABASE_QUERY_ENABLED=true
TOOL_WEB_SEARCH_ENABLED=false
TOOL_WEB_SEARCH_PROVIDER=
TOOL_WEB_SEARCH_API_KEY=
# Optional: enterprise search gateway or local E2E fixture endpoint.
TOOL_WEB_SEARCH_BASE_URL=
TOOL_WEB_SEARCH_TOP_K=5
TOOL_WEB_SEARCH_CACHE_TTL_SECONDS=600
TOOL_WEATHER_ENABLED=true
TOOL_WEATHER_CACHE_TTL_SECONDS=600
TOOL_FILE_PARSE_ENABLED=true
TOOL_FILE_PARSE_MAX_CHARS=4000
TOOL_FILE_PARSE_ALLOWED_DIRS=../storage
TOOL_IMAGE_ANALYZE_ENABLED=true
TOOL_IMAGE_GENERATE_ENABLED=true
TOOL_IMAGE_EDIT_ENABLED=true
IMAGE_BATCH_MAX_COUNT=8
IMAGE_BATCH_CONCURRENCY=8
IMAGE_BATCH_RETRY_ATTEMPTS=2
IMAGE_BATCH_RETRY_BASE_SECONDS=0.6
IMAGE_REFERENCE_MAX_COUNT=8
CHAT_ATTACHMENT_MAX_COUNT=8
CHAT_ATTACHMENT_MAX_FILE_BYTES=5242880
CHAT_ATTACHMENT_MAX_TOTAL_BYTES=20971520
CHAT_ATTACHMENT_TEXT_MAX_CHARS_PER_FILE=50000
CHAT_ATTACHMENT_TEXT_MAX_CHARS_TOTAL=120000
IMAGE_WATERMARK=false
GENERATED_IMAGE_STORAGE=local
GENERATED_IMAGE_DIR=../.local/generated-images
GENERATED_IMAGE_PUBLIC_BASE_URL=http://127.0.0.1:8000/generated-images
TOSUTIL_PATH=tosutil
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_ENDPOINT=tos-cn-shanghai.ivolces.com
TOS_REGION=cn-shanghai
TOS_BUCKET=
TOS_SAVE_PATH_HEAD=zl-dev/
TOS_PUBLIC_URL_HEAD=
TOS_UPLOAD_TIMEOUT_SECONDS=60
TOOL_TODO_ENABLED=true
TOOL_CALENDAR_ENABLED=true
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=30
PROMPT_VERSION=lyle-agent-v1
# 必须为强随机值（openssl rand -hex 32），为空或占位值时服务会拒绝所有请求。
INTERNAL_API_TOKEN=
LOG_LEVEL=INFO
PYTHON_RATE_LIMIT_PER_MINUTE=120
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
POSTGRES_ENABLED=false
POSTGRES_DSN=postgresql://aiapp:aiapp@localhost:5432/ai_memory
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
QDRANT_ENABLED=false
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lyle_knowledge
QDRANT_MEMORY_COLLECTION=lyle_semantic_memory
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=30
RECREATE_VECTOR_COLLECTIONS_ON_DIMENSION_MISMATCH=true
RERANK_ENABLED=false
RERANK_PROVIDER=lexical
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_THREADS=2
RERANK_BATCH_SIZE=8
RERANK_CACHE_DIR=
# Pre-download models before enabling fastembed; never block a request on downloads.
RERANK_LOCAL_FILES_ONLY=true
RERANK_USE_FP16=false
RERANK_FALLBACK_ENABLED=true
RERANK_CANDIDATE_LIMIT=20
RAG_QUERY_REWRITE_ENABLED=true
RAG_MULTI_QUERY_COUNT=3
RAG_CONTEXT_TOP_K=5
RAG_SUFFICIENCY_CHECK_ENABLED=true
# Indexed keyword retrieval and bounded parallel candidate collection.
RAG_OPTIMIZED_RETRIEVAL_ENABLED=true
RAG_PARALLEL_WORKERS=2
RAG_RETRIEVAL_CANDIDATE_LIMIT=20
# One final rerank per retrieval; only used when RERANK_ENABLED=true.
RAG_GLOBAL_RERANK_LIMIT=40
# Keep score fusion and query policy conservative until live corpus evaluation.
RAG_FUSION_MODE=legacy
RAG_ADAPTIVE_RETRIEVAL_ENABLED=false
# Query rewrite / sufficiency LLM calls are opt-in; rule fallback still works.
RAG_AUXILIARY_MODEL_ENABLED=false

# Request caches are scoped by user, conversation, authoritative file versions and permissions.
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_MAX_ENTRIES=256
EMBEDDING_CACHE_MAX_BYTES=8388608
RAG_CANDIDATE_CACHE_ENABLED=true
RAG_CANDIDATE_CACHE_TTL_SECONDS=30
RAG_CANDIDATE_CACHE_MAX_ENTRIES=128
RAG_CANDIDATE_CACHE_MAX_BYTES=8388608
RAG_CONTEXTUAL_QUERY_ENABLED=true
RAG_CONTEXT_HISTORY_TURNS=6
RAG_CONTEXT_HISTORY_MAX_CHARS=1200
# Applies to new ingestion/rebuild; original citation text and offsets are preserved.
RAG_CHUNK_CONTEXT_ENABLED=false
RAG_CHUNK_CONTEXT_MAX_CHARS=480
MILVUS_ENABLED=false
MILVUS_MODE=server
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_LITE_PATH=/tmp/lyle_vector_memory.db
MILVUS_COLLECTION=lyle_vector_memory
MEMORY_SHORT_TERM_LIMIT=12
MEMORY_COMPRESSION_TRIGGER_LIMIT=24
MEMORY_RECALL_LIMIT=6
# Character budgets, not token counts. Fixed behavior constraints share these limits.
MEMORY_LIGHT_CONTEXT_MAX_CHARS=2400
MEMORY_FULL_CONTEXT_MAX_CHARS=8000
STRUCTURED_MEMORY_EXTRACTOR=hybrid
STRUCTURED_MEMORY_CONFIDENCE_THRESHOLD=0.8
STRUCTURED_MEMORY_RECENT_TURNS=6
STRUCTURED_MEMORY_CONFLICT_CONFIDENCE_MARGIN=0.15
# V6.6 explainable and governable memory
MEMORY_UNIFIED_VIEW_ENABLED=true
MEMORY_CONFLICT_SHADOW_ENABLED=false
MEMORY_CONFLICT_CENTER_ENABLED=true
MEMORY_USAGE_EXPLANATION_ENABLED=true
MEMORY_EVIDENCE_CONFIDENCE_ENABLED=true
MEMORY_SOURCE_VALIDATION_ENABLED=true
MEMORY_SOURCE_VALIDATOR_BASE_URL=http://localhost:8080/api
MEMORY_SOURCE_VALIDATION_TIMEOUT_SECONDS=2
MEMORY_SOURCE_VALIDATION_FAIL_CLOSED=true
MEMORY_PURGE_WORKER_ENABLED=true
MEMORY_PURGE_WORKER_INTERVAL_SECONDS=10
# Versioned Schema: confirmed sources -> background build -> published recall.
# False is an explicit legacy rollback, not a fallback on build failure.
MEMORY_SCHEMA_ENABLED=true
MEMORY_FACTS_ENABLED=true
MEMORY_CORE_MAX_CHARS=1200
MEMORY_SCHEMA_BUILD_WITH_LLM=true
MEMORY_SCHEMA_WORKER_INTERVAL=3
MEMORY_SCHEMA_BUILD_LEASE_SECONDS=180
MEMORY_SCHEMA_HISTORY_LIMIT=3
MEMORY_SCHEMA_BUILD_INPUT_MAX_CHARS=64000
MEMORY_SCHEMA_MODEL_MAX_TOKENS=4096
MEMORY_SCHEMA_SMALL_MAX_CHARS=3000
MEMORY_SCHEMA_AGENT_MAX_STEPS=4
MEMORY_SCHEMA_AGENT_READ_MAX_CHARS=8000
# V6.4 AI usage ledger
AI_USAGE_REPORTING_ENABLED=true
AI_USAGE_JAVA_BASE_URL=http://backend-java:8080/api
AI_USAGE_INTERNAL_TOKEN=replace-with-the-same-strong-token-as-java
AI_USAGE_REPORTING_TIMEOUT_SECONDS=3
AI_USAGE_ROUTE_VERSION=v6.4-1
AI_USAGE_PRICING_VERSION=2026-07-23
AI_USAGE_INPUT_PRICE_CNY_PER_MILLION=2
AI_USAGE_OUTPUT_PRICE_CNY_PER_MILLION=8
AI_USAGE_EMBEDDING_PRICE_CNY_PER_MILLION=0
AI_USAGE_IMAGE_COST_MICROS_PER_CALL=0
AI_USAGE_OUTBOX_WORKER_ENABLED=true
